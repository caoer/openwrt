CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-tun=y
# OpenClash kernel support — these kmods force CONFIG_SOCK_DIAG +
# CONFIG_NF_CONNTRACK_EVENTS built into the kernel. MUST be baked: the
# supporting symbols cannot be grafted onto a running kernel (confirmed on
# device — inet_diag/nf_conntrack_netlink fail with Unknown symbol).
# All OpenClash userspace deps (dnsmasq-full, bash, curl, ca-bundle, ip-full,
# ruby, ruby-yaml, unzip, luci-compat) are kernel-independent and install from
# the apk feed at runtime once these kmod packages satisfy their deps.
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
# zram compressed-RAM swap — 512MB router has no swap headroom; mihomo
# (OpenClash core) hits ~290MB RSS and gets OOM-killed in a restart loop.
# kmod-zram needs CONFIG_ZRAM built in, so it must be baked (no runtime graft).
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
# Telemetry — Prometheus node exporter (Lua). Exposes :9100/metrics, scraped by
# the central VictoriaMetrics+Grafana on coscene-vm (.repos/locus-routers/fleet-telemetry).
# ~3-5MB RAM; base package + collectors picked for VR-over-WiFi link debugging.
# wifi_stations gives per-client tx bitrate / tx_failed — the exact signal the
# golden-validation runbook was pulling by hand via `iw dev <ap> station dump`.
CONFIG_PACKAGE_prometheus-node-exporter-lua=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-openwrt=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-wifi_stations=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-thermal=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-netstat=y
CONFIG_PACKAGE_prometheus-node-exporter-lua-ethtool=y
# Operator convenience — full shell + SSH + TLS on the box for debugging.
# Cheap on flash (~5MB), ~0 RAM idle. openssl pulls its default feature set
# via defconfig. NOTE: openssh-server and the stock dropbear both want :22 —
# pick one at runtime (move dropbear to another port or disable it), else the
# second to bind fails. firstboot keeps dropbear; openssh is opt-in per device.
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-keygen=y
