# locus-mesh EasyTier config TEMPLATE for robot routers.
# Rendered to /etc/easytier/config.toml by /usr/sbin/glrobot-provision,
# substituting @NODE_NAME@ and @MESH_IP@ from /etc/glrobot.conf.
# Shared mesh secret + peers are baked (same for every robot router).
#
# Peers = the locus-mesh default join set: tcp+udp to the first 2 bootstrap
# peers in osfiles/lib/osf/mesh.nix (89.208.247.77, 104.224.152.92).
# 3rd live bootstrap (64.186.236.100, dmit-us-lax-2) available for redundancy.
# DO NOT re-add 64.186.233.167 / 23.252.105.155 — PAUSED/dead since 2026-06-07.
instance_name = "@NODE_NAME@"
hostname = "@NODE_NAME@"
ipv4 = "@MESH_IP@/16"
dhcp = false
dev_name = "etmesh"

listeners = [
    "tcp://0.0.0.0:11010",
    "udp://0.0.0.0:11010",
]

[network_identity]
network_name = "locus-mesh"
network_secret = "JGT/8a725S3tCwARkbedUyy39br+X+D60jgKhw1bHKo="

[[peer]]
uri = "tcp://89.208.247.77:11010"

[[peer]]
uri = "udp://89.208.247.77:11010"

[[peer]]
uri = "tcp://104.224.152.92:11010"

[[peer]]
uri = "udp://104.224.152.92:11010"

[flags]
default_protocol = "udp"
enable_encryption = true
enable_ipv6 = true
mtu = 1380
lazy_p2p = true
multi_thread = true
multi_thread_count = 2

[file_logger]
level = "info"
file = "easytier"
dir = "/tmp/log/easytier"
size_mb = 10
count = 2

[console_logger]
level = "warn"
