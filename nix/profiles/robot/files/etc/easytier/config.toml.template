# locus-mesh EasyTier config TEMPLATE for robot routers.
# Rendered to /etc/easytier/config.toml by /usr/sbin/glrobot-provision,
# substituting @NODE_NAME@ and @MESH_IP@ from /etc/glrobot.conf.
#
# Credential-mode leaf: authenticates via ET_CREDENTIAL env (set in init.d).
# No network_secret — backbone validates the per-device credential against
# the credential DB. Credential is baked into /etc/init.d/easytier at flash
# and updated per-unit by glrobot-provision from /etc/glrobot.conf.
#
# CN deployment: raw :11010 CN→US is GFW-dropped. Bootstrap via gateway-cd
# (Aliyun Chengdu, CN cloud hub) over wss/ws — TLS-framed, DPI-resistant.
# Also direct-peer with volcengine-sh/gz (CN domestic, no GFW).
instance_name = "@NODE_NAME@"
hostname = "@NODE_NAME@"
ipv4 = "@MESH_IP@/16"
dhcp = false
dev_name = "tun0"

listeners = [
    "tcp://0.0.0.0:11010",
    "udp://0.0.0.0:11010",
]

[network_identity]
network_name = "locus-mesh"

# gateway-cd (10.144.144.11) — Aliyun Chengdu, CN cloud hub, DPI-resistant
[[peer]]
uri = "wss://47.109.42.219:11012/"

[[peer]]
uri = "ws://47.109.42.219:11011/"

# volcengine-sh (10.144.144.15) — CN domestic, direct reachable
[[peer]]
uri = "tcp://14.103.44.144:11010"

[[peer]]
uri = "udp://14.103.44.144:11010"

# volcengine-gz (10.144.144.16) — CN domestic, direct reachable
[[peer]]
uri = "tcp://118.145.101.7:11010"

[[peer]]
uri = "udp://118.145.101.7:11010"

[flags]
default_protocol = "udp"
enable_encryption = true
enable_ipv6 = true
mtu = 1380
lazy_p2p = true
multi_thread = true
multi_thread_count = 2
disable_sym_hole_punching = true

[file_logger]
level = "info"
file = "easytier"
dir = "/tmp/log/easytier"
size_mb = 10
count = 2

[console_logger]
level = "warn"
