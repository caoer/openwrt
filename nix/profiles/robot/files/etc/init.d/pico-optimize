#!/bin/sh /etc/rc.common
# Auto-optimize PICO headsets that join the robot router's network.
# Watches DHCP leases, probes SSH :2222, applies VR-WiFi optimizations.
# Starts after networking + DHCP are up.

START=95
USE_PROCD=1

start_service() {
	procd_open_instance pico-optimize
	procd_set_param command /usr/sbin/pico-optimize-daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
