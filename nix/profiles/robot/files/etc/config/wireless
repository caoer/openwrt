# Robot router radios (mt76 / mac80211, GL-MT3600BE MT7987/mt7996e dual-band).
#
# Default-baked topology (works out-of-box after any flash):
#   5 GHz  = AP for PICO VR headset + operator access (EHT80, UNII-3 preferred)
#   2.4 GHz = STA client to upstream AP (coScene-Robot factory network)
#
# SSID = <hostname>-{wireless|umbilical}, switched by glrobot-mode (physical button).
# Default baked SSID uses hostname "gl-robot"; provision sets per-unit name
# (e.g. eva-02) and glrobot-mode updates SSID accordingly.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/11280000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option radio '0'
	option band '2g'
	option channel 'auto'
	option htmode 'HE40'
	option country 'US'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/11280000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option radio '1'
	option band '5g'
	option channel '149'
	option htmode 'HE80'
	option country 'US'
	option disabled '0'

# 5 GHz AP — primary link for PICO VR headset and operator WiFi access.
# SSID set by glrobot-mode: <node>-wireless (normal) or <node>-umbilical (gateway).
config wifi-iface 'ap_5g'
	option device 'radio1'
	option mode 'ap'
	option network 'lan'
	option ssid 'gl-robot-wireless'
	option encryption 'psk2'
	option key '66666666'
	option disabled '0'

# 2.4 GHz STA — connects to upstream factory AP for internet/management.
config wifi-iface 'sta_2g'
	option device 'radio0'
	option mode 'sta'
	option network 'wwan'
	option ssid 'coScene-Robot'
	option encryption 'psk2'
	option key '99999999'
	option disabled '0'
