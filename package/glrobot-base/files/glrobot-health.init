#!/bin/sh /etc/rc.common
# glrobot-health init — START between core services and user services (LEDE convention 45-60)

START=55
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/glrobot-health 30
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
